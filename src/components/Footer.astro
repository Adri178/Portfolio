---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-800">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 px-5 py-8 text-sm text-slate-500 sm:flex-row sm:px-6 dark:text-slate-400"
  >
    <p>© {year} {site.name}. Dibuat dengan Astro & Tailwind CSS.</p>
    <a href="#top" class="font-medium transition hover:text-accent-600 dark:hover:text-accent-400">
      Kembali ke atas ↑
    </a>
  </div>
</footer>
