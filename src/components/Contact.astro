---
import SocialIcon from "./SocialIcon.astro";
import { contacts, contactEmail } from "../data/site";
---

<section id="contact" class="border-t border-slate-100 bg-slate-50/60 dark:border-slate-800 dark:bg-slate-900/40">
  <div class="mx-auto max-w-5xl px-5 py-16 text-center sm:px-6 sm:py-28">
    <div class="reveal mx-auto max-w-2xl">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        Contact
      </h2>
      <p class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Mari berkolaborasi
      </p>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
        Tertarik bekerja sama atau punya pertanyaan? Kirim email atau temui saya
        di kanal berikut.
      </p>

      <a
        href={`mailto:${contactEmail}`}
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-accent-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-accent-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-600"
      >
        <SocialIcon name="email" class="h-5 w-5" />
        {contactEmail}
      </a>

      <ul class="mt-10 flex flex-wrap items-center justify-center gap-3">
        {
          contacts.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={c.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                aria-label={c.label}
                title={c.label}
                class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-600 transition hover:-translate-y-0.5 hover:border-accent-300 hover:text-accent-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-accent-700 dark:hover:text-accent-400"
              >
                <SocialIcon name={c.icon} class="h-5 w-5" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
