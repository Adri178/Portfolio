---
import { skills } from "../data/site";
---

<section id="skills" class="border-y border-slate-100 bg-slate-50/60 dark:border-slate-800 dark:bg-slate-900/40">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:px-6 sm:py-24">
    <div class="reveal max-w-2xl">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
        Skills / Tech Stack
      </h2>
      <p class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
        Alat yang saya gunakan
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        skills.map((group) => (
          <div class="reveal rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="text-sm font-semibold text-slate-900 dark:text-white">
              {group.label}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-md bg-accent-50 px-2.5 py-1 text-sm font-medium text-accent-700 dark:bg-accent-900/30 dark:text-accent-300">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
