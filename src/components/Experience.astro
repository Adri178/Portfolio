---
import { experience } from "../data/site";
---

<section id="experience" class="mx-auto max-w-5xl px-5 py-16 sm:px-6 sm:py-24">
  <div class="reveal max-w-2xl">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
      Experience
    </h2>
    <p class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
      Pengalaman kerja
    </p>
  </div>

  <ol class="mt-10 space-y-8 border-l border-slate-200 pl-6 dark:border-slate-800">
    {
      experience.map((item) => (
        <li class="reveal relative">
          <span class="absolute -left-[1.6rem] top-1.5 h-3 w-3 rounded-full border-2 border-accent-600 bg-white dark:bg-slate-950" />
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">
              {item.role}
              <span class="text-accent-600 dark:text-accent-400"> · {item.company}</span>
            </h3>
            <span class="text-sm font-medium text-slate-500 dark:text-slate-400">
              {item.period}
            </span>
          </div>
          <p class="mt-2 text-slate-600 dark:text-slate-300">{item.description}</p>
        </li>
      ))
    }
  </ol>
</section>
