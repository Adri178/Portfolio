---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";

// Project unggulan ditampilkan lebih dulu.
const sorted = [...projects].sort(
  (a, b) => Number(b.highlight ?? false) - Number(a.highlight ?? false)
);
---

<section id="projects" class="mx-auto max-w-5xl px-5 py-16 sm:px-6 sm:py-24">
  <div class="reveal max-w-2xl">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
      Projects
    </h2>
    <p class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">
      Pilihan project AI/ML
    </p>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      Tiap project menampilkan masalah → solusi → hasil terukur. Klik untuk demo
      atau kode sumber.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
    {sorted.map((project) => <ProjectCard project={project} />)}
  </div>
</section>
