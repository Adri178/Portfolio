---
import { about } from "../data/site";
---

<section id="about" class="mx-auto max-w-5xl px-5 py-16 sm:px-6 sm:py-24">
  <div class="reveal">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-accent-600 dark:text-accent-400">
      About
    </h2>
    <p
      class="mt-4 max-w-3xl text-xl leading-relaxed text-slate-700 sm:text-2xl dark:text-slate-200"
    >
      {about.paragraph}
    </p>

    <div class="mt-8">
      <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Tech utama</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {
          about.mainTech.map((tech) => (
            <li class="rounded-md border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-700 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200">
              {tech}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
